# Supabase Postgres (pooler for app queries)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres (direct for migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App URL (for invite redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: shared rate limiting for multi-instance production (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# Messaging (SMS / WhatsApp) — leave unset to dry-run / log only
# MSG91_AUTH_KEY=""
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""

# Razorpay (patient invoice payments + SaaS) — stub orders when unset
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# Patient portal session signing
# PORTAL_SESSION_SECRET="change-me"

# ABDM sandbox (India) — enable care-context stub linking
# ABDM_SANDBOX="1"
